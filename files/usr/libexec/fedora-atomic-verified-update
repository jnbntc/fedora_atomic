#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="${FEDORA_ATOMIC_REPOSITORY:-ghcr.io/jnbntc/fedora_atomic}"
CHANNEL="${FEDORA_ATOMIC_CHANNEL:-stable}"
SOURCE_REPOSITORY="${FEDORA_ATOMIC_SOURCE_REPOSITORY:-jnbntc/fedora_atomic}"
SOURCE_REF="${FEDORA_ATOMIC_SOURCE_REF:-refs/heads/main}"
WORKFLOW_PATH="${FEDORA_ATOMIC_WORKFLOW_PATH:-.github/workflows/build.yml}"

COSIGN_BIN="${COSIGN_BIN:-cosign}"
SKOPEO_BIN="${SKOPEO_BIN:-skopeo}"
RPM_OSTREE_BIN="${RPM_OSTREE_BIN:-rpm-ostree}"
JQ_BIN="${JQ_BIN:-jq}"
HOST_PACKAGES_CONFIG="${FEDORA_ATOMIC_HOST_PACKAGES_CONFIG:-/etc/fedora-atomic/host-packages.json}"

log()  { printf '[verified-update] %s\n' "$*"; }
warn() { printf '[verified-update] WARN: %s\n' "$*" >&2; }
die()  { printf '[verified-update] ERROR: %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Falta comando requerido: $1"
}

# Estado persistente: una comprobación fallida o diferida no rejuvenece last-success.
STATE_DIR="${FEDORA_ATOMIC_STATE_DIR:-${STATE_DIRECTORY:-/var/lib/fedora-atomic-verified-update}}"
POWER_SUPPLY_ROOT="${POWER_SUPPLY_ROOT:-/sys/class/power_supply}"
SUCCESS_INTERVAL=$((6 * 60 * 60))
STALE_AFTER=$((72 * 60 * 60))

if [[ "${FEDORA_ATOMIC_ALLOW_NON_ROOT:-0}" != "1" ]]; then
  [[ "${EUID}" -eq 0 ]] || die "Debe ejecutarse como root"
fi

umask 0077
mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"
require_cmd flock
exec 9>"${STATE_DIR}/lock"
if ! flock -n 9; then
  log "Ya hay otra ejecución del updater; no se hace nada."
  exit 0
fi

write_stamp() {
  local name="$1" value="$2"
  printf '%s\n' "$value" >"${STATE_DIR}/${name}.tmp"
  mv -f "${STATE_DIR}/${name}.tmp" "${STATE_DIR}/${name}"
}

read_stamp() {
  local name="$1" value
  if [[ ! -e "${STATE_DIR}/${name}" ]]; then
    printf '0\n'
    return
  fi
  value="$(cat "${STATE_DIR}/${name}")"
  # Un reloj atrasado o estado corrupto nunca habilita recuperación laboral.
  if [[ ! "$value" =~ ^[1-9][0-9]{0,10}$ ]] || (( value > now )); then
    warn "Timestamp ${name} inválido/futuro; se reinicia su plazo."
    if [[ "$name" == last-success ]]; then
      # No inventar una verificación exitosa: reiniciar sólo el período de gracia.
      write_stamp first-seen "$now"
      rm -f "${STATE_DIR}/last-success"
      value=0
    else
      write_stamp "$name" "$now"
      value="$now"
    fi
  fi
  printf '%s\n' "$value"
}

on_external_power() {
  local supply type online
  for supply in "$POWER_SUPPLY_ROOT"/*; do
    [[ -r "${supply}/type" && -r "${supply}/online" ]] || continue
    type="$(cat "${supply}/type")"
    online="$(cat "${supply}/online")"
    case "$type" in
      Mains|USB*) [[ "$online" == 1 ]] && return 0 ;;
    esac
  done
  return 1
}

policy_allows_update() {
  local clock weekday hhmm
  if [[ "${FEDORA_ATOMIC_ALLOW_ANY_TIME:-0}" == 1 ]]; then
    mode=manual
    return 0
  fi
  # Una sola lectura conserva coherencia al cruzar medianoche.
  clock="$(date +%u%H%M)"
  weekday="${clock:0:1}"
  hhmm=$((10#${clock:1:4}))
  if (( (hhmm >= 220 && hhmm <= 310) || (hhmm >= 1820 && hhmm <= 1910) )); then
    mode=window
    return 0
  fi
  # Horario laboral conservador: lunes a viernes, 08:00 <= hora < 18:20.
  if (( weekday >= 6 || hhmm < 800 || hhmm >= 1820 )); then
    mode=catch-up
    return 0
  fi
  if (( $(date +%s) - baseline >= STALE_AFTER )) && on_external_power; then
    mode=stale-recovery
    return 0
  fi
  return 1
}

now="$(date +%s)"
last_success="$(read_stamp last-success)"
first_seen="$(read_stamp first-seen)"
if (( first_seen == 0 )); then
  first_seen="$now"
  write_stamp first-seen "$now"
fi
last_attempt="$(read_stamp last-attempt)"
baseline="$last_success"
(( baseline > 0 )) || baseline="$first_seen"
mode=""

if ! policy_allows_update; then
  log "Horario laboral: se difiere hasta fuera de jornada (recuperación: 72 h sin éxito y alimentación externa)."
  exit 0
fi

# Las dos ventanas originales y el override manual siguen siendo explícitos.
# El catch-up evita consultas de red repetidas después de un éxito reciente.
if [[ "$mode" == catch-up || "$mode" == stale-recovery ]]; then
  if (( last_success > 0 && now - last_success < SUCCESS_INTERVAL )); then
    log "Comprobación exitosa hace menos de 6 h; se difiere el catch-up."
    exit 0
  fi
  retry_interval=$((30 * 60))
  [[ "$mode" != stale-recovery ]] || retry_interval="$SUCCESS_INTERVAL"
  if (( last_attempt > 0 && now - last_attempt < retry_interval )); then
    log "Intento reciente; se difiere ${mode}."
    exit 0
  fi
fi

write_stamp last-attempt "$now"
log "Política autorizada: ${mode}."

mark_success() {
  write_stamp last-success "$(date +%s)"
}

for cmd in "$COSIGN_BIN" "$SKOPEO_BIN" "$RPM_OSTREE_BIN" "$JQ_BIN"; do
  require_cmd "$cmd"
done

log "Resolviendo canal ${CHANNEL}"
inspect_json="$("$SKOPEO_BIN" inspect "docker://${REPOSITORY}:${CHANNEL}")"
digest="$("$JQ_BIN" -r '.Digest // empty' <<<"$inspect_json")"
revision="$("$JQ_BIN" -r '.Labels["org.opencontainers.image.revision"] // empty' <<<"$inspect_json")"

[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "Digest inválido: ${digest:-<vacío>}"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "Revision OCI inválida: ${revision:-<vacío>}"

image_ref="${REPOSITORY}@${digest}"
identity="https://github.com/${SOURCE_REPOSITORY}/${WORKFLOW_PATH}@${SOURCE_REF}"
issuer="https://token.actions.githubusercontent.com"

log "Verificando firma Cosign: ${digest}"
"$COSIGN_BIN" verify \
  --certificate-identity "$identity" \
  --certificate-oidc-issuer "$issuer" \
  --certificate-github-workflow-repository "$SOURCE_REPOSITORY" \
  --certificate-github-workflow-ref "$SOURCE_REF" \
  --certificate-github-workflow-sha "$revision" \
  "$image_ref" >/dev/null

log "Verificando provenance SLSA"
"$COSIGN_BIN" verify-attestation \
  --certificate-identity "$identity" \
  --certificate-oidc-issuer "$issuer" \
  --certificate-github-workflow-repository "$SOURCE_REPOSITORY" \
  --certificate-github-workflow-ref "$SOURCE_REF" \
  --certificate-github-workflow-sha "$revision" \
  --type 'https://slsa.dev/provenance/v1' \
  "$image_ref" >/dev/null

log "Verificando SBOM SPDX"
"$COSIGN_BIN" verify-attestation \
  --certificate-identity "$identity" \
  --certificate-oidc-issuer "$issuer" \
  --certificate-github-workflow-repository "$SOURCE_REPOSITORY" \
  --certificate-github-workflow-ref "$SOURCE_REF" \
  --certificate-github-workflow-sha "$revision" \
  --type 'https://spdx.dev/Document/v2.3' \
  "$image_ref" >/dev/null

log "Supply chain OK para revision ${revision}"

status_json="$("$RPM_OSTREE_BIN" status --json)"
"$JQ_BIN" -e '
  (.deployments | type == "array" and length > 0)
  and ([.deployments[] | select(.booted == true)] | length == 1)
' <<<"$status_json" >/dev/null || die "Estado de deployments inválido"
booted_digest="$("$JQ_BIN" -r '
  .deployments[] | select(.booted == true) | .["container-image-reference-digest"] // empty
' <<<"$status_json")"
booted_ref="$("$JQ_BIN" -r '
  .deployments[] | select(.booted == true) | .["container-image-reference"] // empty
' <<<"$status_json")"
# El primer deployment es el predeterminado, aun si no tiene staged=true.
# rpm-ostree deriva de él las solicitudes de paquetes de la transacción.
pending="$("$JQ_BIN" -r '.deployments[0].booted != true' <<<"$status_json")"
pending_digest="$("$JQ_BIN" -r '.deployments[0]["container-image-reference-digest"] // empty' <<<"$status_json")"
pending_ref="$("$JQ_BIN" -r '.deployments[0]["container-image-reference"] // empty' <<<"$status_json")"
if [[ "$pending" == true ]]; then
  [[ "$pending_digest" =~ ^sha256:[0-9a-f]{64}$ &&
     "$pending_ref" == "ostree-unverified-registry:${REPOSITORY}@${pending_digest}" ]] \
    || die "Hay un deployment pendiente ajeno o no fijado por digest; se conserva sin cambios."
  if [[ "$pending_digest" == "$digest" ]]; then
    log "Stable ${digest} ya está staged/pendiente; reiniciar cuando sea conveniente. Los paquetes se revisarán después del boot."
    mark_success
    exit 0
  fi
fi

# Sólo migrar RPM locales explícitamente autorizados; no instalar apps ausentes.
"$JQ_BIN" -e '
  .schema_version == 1 and (.packages | type == "array")
  and all(.packages[]; type == "string" and test("^[a-zA-Z0-9][a-zA-Z0-9+_.-]*$"))
  and ((.packages | unique | length) == (.packages | length))
' "$HOST_PACKAGES_CONFIG" >/dev/null || die "Política host-packages inválida o ausente"
managed_names="$("$JQ_BIN" -c '.packages' "$HOST_PACKAGES_CONFIG")"
# shellcheck disable=SC2016 # Variables de jq, no del shell.
migrations="$(printf '%s\n' "$managed_names" "$status_json" | "$JQ_BIN" -cs '
  .[0] as $names
  | [.[1].deployments[0]["requested-local-packages"][]? | . as $nevra
   | capture("^(?<name>.+)-[^-]+-[^-]+$").name as $name
   | select($names | index($name)) | {name:$name, nevra:$nevra}]
')"
"$JQ_BIN" -e '([.[].name] | unique | length) == length' <<<"$migrations" >/dev/null \
  || die "Solicitudes locales ambiguas para los paquetes gestionados"
# shellcheck disable=SC2016
managed_active="$(printf '%s\n' "$managed_names" "$migrations" "$status_json" | "$JQ_BIN" -rs '
  .[0] as $names | .[1] as $migrations | .[2].deployments[0] as $d
  | any($names[]; . as $name
      | (($d["requested-packages"] // []) | index($name)) != null
        or any($migrations[]; .name == $name))
')"
package_args=()
while IFS=$'\t' read -r name nevra; do
  [[ -n "$name" ]] || continue
  log "Migración host-local autorizada: ${nevra} -> paquete de repositorio ${name}"
  package_args+=("--uninstall=${nevra}" "--install=${name}")
done < <("$JQ_BIN" -r '.[] | [.name, .nevra] | @tsv' <<<"$migrations")

if [[ "$pending" == false && "$booted_digest" == "$digest" && "$managed_active" == false ]]; then
  log "El sistema ya está arrancado en stable ${digest}; sin paquetes host-locales gestionados."
  mark_success
  exit 0
fi

# Conservar sólo las solicitudes necesarias para la postvalidación. Tanto éstas
# como los demás JSON viajan por stdin, nunca por argv ni con topes artificiales.
previous_requests="$("$JQ_BIN" -c '
  .deployments[0] | {
    local_packages: (.["requested-local-packages"] // []),
    layered_packages: (.["requested-packages"] // [])
  }
' <<<"$status_json")"

guard_before_transaction() {
  if ! policy_allows_update; then
    log "La guarda de horario/energía cambió durante la verificación; stage diferido."
    exit 0
  fi
  # No pisar cambios de un administrador mientras se comprobaba la red/repos.
  local current
  current="$("$RPM_OSTREE_BIN" status --json)"
  [[ "$("$JQ_BIN" -cS '.deployments' <<<"$current")" == \
     "$("$JQ_BIN" -cS '.deployments' <<<"$status_json")" ]] \
    || die "Los deployments cambiaron durante la comprobación; reintentar en la próxima ejecución."
}

target="ostree-unverified-registry:${REPOSITORY}@${digest}"
if [[ "$pending" == false && "$booted_digest" == "$digest" ]]; then
  [[ "$booted_ref" == "$target" ]] || die "El origen booted no está fijado al digest verificado; no se ejecuta upgrade."
fi
guard_before_transaction
if [[ "$managed_active" == true ]]; then
  log "Actualizando metadatos RPM para los paquetes host-locales gestionados"
  "$RPM_OSTREE_BIN" refresh-md --force
  guard_before_transaction
fi

if [[ "$pending" == false && "$booted_digest" == "$digest" ]]; then
  # upgrade sólo sigue la referencia INMUTABLE que acaba de verificarse.
  # Así también se actualizan capas RPM cuando el digest OCI no cambia.
  log "Comprobando actualizaciones RPM sobre el mismo stable verificado"
  rc=0
  "$RPM_OSTREE_BIN" upgrade --unchanged-exit-77 "${package_args[@]}" || rc=$?
  if (( rc == 77 )); then
    (( ${#package_args[@]} == 0 )) || die "rpm-ostree no aplicó la migración solicitada"
    log "Stable y paquetes de repositorio sin novedades."
    mark_success
    exit 0
  fi
  (( rc == 0 )) || die "Falló la actualización de paquetes host-locales (rpm-ostree: ${rc})"
else
  # Sin cleanup --pending: rpm-ostree reemplaza el pendiente transaccionalmente.
  # Si falla un repo, dependencia o firma, el pendiente anterior se conserva.
  log "Preparando deployment verificado y paquetes host-locales: ${target}"
  "$RPM_OSTREE_BIN" rebase "$target" "${package_args[@]}"
fi

status_after="$("$RPM_OSTREE_BIN" status --json)"
# shellcheck disable=SC2016
printf '%s\n' "$migrations" "$previous_requests" "$status_after" |
"$JQ_BIN" -se --arg digest "$digest" --arg ref "$target" '
  .[0] as $migrations | .[1] as $previous | .[2].deployments[0] as $d
  | $d.booted != true
    and $d["container-image-reference-digest"] == $digest
    and $d["container-image-reference"] == $ref
    and all($migrations[]; . as $m
      | (($d["requested-packages"] // []) | index($m.name)) != null
        and (any($d["requested-local-packages"][]?;
          capture("^(?<name>.+)-[^-]+-[^-]+$").name == $m.name) | not))
    and all($previous.local_packages[]; . as $old
      | any($migrations[]; .nevra == $old)
        or (($d["requested-local-packages"] // []) | index($old)) != null)
    and all($previous.layered_packages[]; . as $old
      | (($d["requested-packages"] // []) | index($old)) != null)
' >/dev/null || die "rpm-ostree no dejó el digest y las solicitudes de paquetes esperados"

mark_success
log "Update preparado correctamente. NO se reinicia automáticamente."
log "Nuevo stable staged/pendiente: ${digest}"
